<Bindings>
	<Binding name="WANDERER_REVEAL" runOnUp="true" header="WANDERER">
		Wanderer_Reveal(keystate)
	</Binding>
	<Binding name="WANDERER_JOURNAL">
		Wanderer_ToggleJournal()
	</Binding>
	<Binding name="WANDERER_PHOTO">
		Wanderer_TogglePhoto()
	</Binding>
	<Binding name="WANDERER_MESSAGES">
		Wanderer_ToggleMessages()
	</Binding>
	<Binding name="WANDERER_TODO">
		Wanderer_ToggleTodo()
	</Binding>
	<Binding name="WANDERER_MARKERS" runOnUp="true">
		Wanderer_Markers(keystate)
	</Binding>
	<Binding name="CLICK WandererCampfire:LeftButton">
	</Binding>
</Bindings>
